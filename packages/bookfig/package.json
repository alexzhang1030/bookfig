{
  "name": "bookfig",
  "version": "0.1.0",
  "description": "Single-colour technical-book figures: primitives plus Mermaid (flowchart, sequence, state) to SVG/PNG.",
  "license": "MIT",
  "bin": {
    "bookfig": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "src",
    "fixtures"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "bookfig": "vpx src/cli.ts"
  },
  "dependencies": {
    "@hpcc-js/wasm-graphviz": "^1.30.0",
    "@resvg/resvg-js": "^2.6.2"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
